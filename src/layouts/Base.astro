---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string }
const { title = 'CasinoRank UA — порівняння операторів та перевірка ліцензій', description = 'Незалежна платформа: актуальна інформація про операторів, ліцензії та платіжні методи.' } = Astro.props;
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080D18" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip visually-hidden">До основного вмісту</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
<style is:global>
  .skip:focus { position: fixed; z-index: 100; top: 8px; left: 8px; width: auto; height: auto; clip: auto; padding: 12px 16px; background: var(--blue); color: #fff; border-radius: 8px; }
</style>
