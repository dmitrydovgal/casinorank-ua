---
import { ArrowRight } from '@lucide/astro';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { methodology } from '../data/content';
---
<section class="section method" id="methodology" aria-labelledby="method-title">
  <div class="container">
    <SectionHead id="method-title" eyebrow="Методологія" title="Як ми оцінюємо операторів" text="Ми структуруємо інформацію за прозорими критеріями та вказуємо джерела й дату перевірки." />
    <div class="grid">
      {methodology.map((f, i) => (
        <div class="feat">
          <span class="num">0{i + 1}</span>
          <span class="ico"><Icon name={f.icon} size={24} /></span>
          <h3>{f.title}</h3>
          <p class="muted">{f.text}</p>
        </div>
      ))}
    </div>
    <a class="link" href="/methodology">Дізнатися про методологію <ArrowRight size={16} aria-hidden="true" /></a>
  </div>
</section>
<style>
  .method { background: linear-gradient(180deg, #0b1424 0%, #0d1a30 100%); border-block: 1px solid var(--line); overflow: hidden; }
  .method::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / .03) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / .03) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse at 50% 0%, #000, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000, transparent 70%); pointer-events: none; }
  .container { position: relative; }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin-bottom: 40px; border: 1px solid var(--line); border-radius: var(--r-lg); background: rgb(8 13 24 / .5); }
  .feat { position: relative; padding: 32px 28px; display: grid; gap: 12px; align-content: start; border-right: 1px solid var(--line); }
  .feat:last-child { border-right: 0; }
  .num { position: absolute; top: 24px; right: 24px; font-size: 13px; font-weight: 800; color: rgb(138 184 255 / .45); letter-spacing: .08em; }
  .ico { width: 48px; height: 48px; border-radius: 12px; display: grid; place-items: center; color: var(--cyan); background: rgb(38 132 255 / .12); border: 1px solid rgb(38 132 255 / .25); margin-bottom: 8px; }
  p { font-size: 15px; }
  @media (max-width: 1024px) { .grid { grid-template-columns: 1fr 1fr; } .feat:nth-child(2) { border-right: 0; } .feat:nth-child(-n+2) { border-bottom: 1px solid var(--line); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } .feat { border-right: 0; border-bottom: 1px solid var(--line); } .feat:last-child { border-bottom: 0; } }
</style>
