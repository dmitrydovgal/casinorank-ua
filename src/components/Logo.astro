---
interface Props { href?: string }
const { href = '/' } = Astro.props;
---
<a href={href} class="logo" aria-label="CasinoRank UA — на головну">
  <span class="mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="24" height="24"><path d="M6 24 4.5 11l7 6L16 7l4.5 10 7-6L26 24z" fill="#fff" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/><rect x="7" y="25.5" width="18" height="2.2" rx="1.1" fill="#fff"/></svg>
  </span>
  <span class="word">CasinoRank<b>UA</b></span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; }
  .mark { width: 36px; height: 36px; border-radius: 10px; background: var(--grad-blue); display: grid; place-items: center; box-shadow: 0 4px 16px rgb(38 132 255 / .35); }
  .word { font-weight: 800; font-size: 19px; letter-spacing: -0.02em; display: inline-flex; align-items: center; gap: 6px; }
  .word b { font-size: 11px; letter-spacing: .08em; padding: 3px 7px; border-radius: 6px; background: rgb(38 132 255 / .16); color: var(--soft-blue); font-weight: 800; }
</style>
